	"cis-ns-summary": {
		"default": "nl",
		"strings": {
			"headerDepartureTime": {
				"_translationNote": "As in, the time that the service is due to [depart].",
				"cy": "Gadael",
				"de": "Abfahrt",
				"en": "Depart",
				"fi": "Aika",
				"fr": "Départ",
				"it": false,
				"nl": "Vertrek",
				"sv": false
			},
			"headerDestinationAndRemarks": {
				"_translationNote": "Direct translation of 'to' and 'remarks' if possible, but translations of 'Destination' and 'notes' are also acceptable. Capitalise both words, and separate with a forward-slash (no space).",
				"cy": "Yn mynd i/Sylwadau",
				"de": "An/Kommentare",
				"en": "To/Remarks",
				"fi": "Määräasema/Huomiot",
				"fr": "À/Remarques",
				"it": false,
				"nl": "Naar/Opmerkingen",
				"sv": false
			},
			"headerPlatformAndTrain": {
				"_translationNote": "Use whichever of platform/track is more commonly used in the relevant language. Capitalise both words, and separate with a forward-slash (no space).",
				"cy": "Platfform/Trên",
				"de": "Gleis/Zug",
				"en": "Platform/Train",
				"fi": "Raide/Juna",
				"fr": "Quai/Train",
				"it": false,
				"nl": "Spoor/Trein",
				"sv": false
			},
			"serviceCancelled": {
				"_translationNote": "Capitalise as if it was the start of a sentence. Needs to work in combination with serviceReason below.",
				"cy": "Canslwyd",
				"de": "Ausfall",
				"en": "Cancelled",
				"fi": "Peruttu",
				"fr": "Supprimé",
				"it": "Soppresso",
				"nl": "Rijdt niet",
				"sv": false
			},
			"serviceReason": {
				"_translationNote": "Needs to work in combination with serviceCancelled above. An example of a reason that could follow is 'a fault on this train'.",
				"cy": "oherwydd",
				"de": "wegen",
				"en": "due to",
				"fi": "perumisen syy",
				"fr": "en raison de",
				"it": false,
				"nl": "door",
				"sv": false
			},
			"bus": {
				"cy": "bws",
				"de": "bus",
				"en": "bus",
				"fi": "bussi",
				"fr": "bus",
				"it": "bus",
				"nl": "bus",
				"sv": "buss"
			},
			"serviceLargeDelay": {
				"_translationNote": "{hours} and {mins} will both be integers",
				"cy": "{hours}a{mins}",
				"de": "{hours}s{mins}",
				"en": "{hours}h{mins}",
				"fi": "{hours}t{mins}",
				"fr": "{hours}h{mins}",
				"it": "{hours}o{mins}",
				"nl": "{hours}u{mins}",
				"sv": "{hours}t{mins}"
			}
		}
	},
	"cis-sbb-summary": {
		"default": "de",
		"strings": {
			"noInfo": {
				"_translationNote": "Should not explicitly mention an app and/or website - keep it generically 'online'. Capitalise as a full sentence.",
				"cy": false,
				"de": "Bitte konsultieren Sie den Online-Fahrplan",
				"en": "Please consult the online timetable",
				"fi": false,
				"fr": "Merci de vous référer à l'horaire en ligne",
				"it": "Si prega di consultare l'orario online",
				"nl": "Gebruik alstublieft de online dienstregeling",
				"sv": false
			},
			"headerDestination": {
				"_translationNote": "Direct translation of 'to' if possible, but a translation of 'Destination' is also acceptable.",
				"cy": "Yn mynd i",
				"de": "Nach",
				"en": "To",
				"fi": "Määräasema",
				"fr": "Pour",
				"it": "Per",
				"nl": "Naar",
				"sv": false
			},
			"headerOrigin": {
				"_translationNote": "Direct translation of 'from' if possible, but a translation of 'Origin' is also acceptable.",
				"cy": "Yn dod o",
				"de": "Von",
				"en": "From",
				"fi": "Lähtöasema",
				"fr": "De",
				"it": "Da",
				"nl": "Van",
				"sv": false
			},
			"headerPlatform": {
				"_translationNote": "Use whichever of platform/track is more commonly used in the relevant language.",
				"cy": "Platfform",
				"de": "Gleis",
				"en": "Platform",
				"fi": "Raide",
				"fr": "Voie",
				"it": "Binario",
				"nl": "Spoor",
				"sv": false
			},
			"headerNote": {
				"_translationNote": "This column states if a service is cancelled/delayed, and shows any other message related to it. Translation of 'remarks' is acceptable if there is no direct translation for 'note'. Please assume to be singular.",
				"cy": "Nodyn",
				"de": "Hinweis",
				"en": "Note",
				"fi": "Huomio",
				"fr": "Remarque",
				"it": "Nota",
				"nl": "Opmerking",
				"sv": false
			},
			"serviceCancelled": {
				"_translationNote": "Capitalise as if it was the start of a sentence.",
				"cy": "Canslwyd",
				"de": "Ausfall",
				"en": "Cancelled",
				"fi": "Peruttu",
				"fr": "Supprimé",
				"it": "Soppresso",
				"nl": "Rijdt niet",
				"sv": false
			},
			"serviceDelayedMins": {
				"_translationNote": "Although this will be used as a full sentence, keep it lowercase to match SBB's style. {min} will be an integer, assumed to be >1.",
				"cy": false,
				"de": "ca. {min} Min später",
				"en": "about {min} min delay",
				"fi": "viivästynyt {min} min",
				"fr": "retard env. {min} min",
				"it": "ca {min} min di ritardo",
				"nl": "vertraagd met {min} min",
				"sv": false
			},
			"serviceDelayedIndefinitely": {
				"_translationNote": "Should be clear that the length of delay is unknown. Other similar words can be used if no direct translation for 'indefinitely'.",
				"cy": false,
				"de": "unb. Verspätung",
				"en": "Delayed indefinitely",
				"fi": "Myöhässä",
				"fr": "Retard indéterminé",
				"it": "Ritardo imprecisato",
				"nl": "Onbepaalde vertraging",
				"sv": false
			}
		}
	}
